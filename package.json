{
  "name": "gpu-cloud-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "GPU Cloud Marketplace MVP foundation.",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace frontend\" \"npm run dev --workspace backend\"",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:backend": "npm run dev --workspace backend",
    "build": "npm run build --workspace frontend",
    "start": "npm run start --workspace backend",
    "seed:admin": "npm run seed:admin --workspace backend",
    "generate:sitemap": "npm run generate:sitemap --workspace frontend",
    "media:sync-cloudinary": "npm run media:sync-cloudinary --workspace backend",
    "email:test": "npm run email:test --workspace backend",
    "security:migrate-secrets": "npm run security:migrate-secrets --workspace backend",
    "lint": "eslint frontend backend",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^9.31.0",
    "concurrently": "^9.2.0",
    "eslint": "^9.31.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "prettier": "^3.6.2"
  }
}
